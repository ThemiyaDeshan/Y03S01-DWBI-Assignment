  <Source dwd:design-time-name="dbad8bed-03d0-462c-bbf4-5d8ba81327f6">
    <DataSourceViewID>Assignment Dw</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="3e4b7ed2-bc03-40c7-a877-22d19631d966">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Delivery Days]
 AS [Measures].[Delivery Days Sum] / [Measures].[Delivery Days Count], 
FORMAT_STRING = 0.00, 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Late Delivery Rate]
 AS [Measures].[Late Delivery Count] / [Measures].[Order Item Count], 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Review Score]
 AS [Measures].[Review Score Sum] / [Measures].[Review Count], 
FORMAT_STRING = 0.00, 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="5f5a7698-cb14-41d3-bdc5-ed7d5b0d2edd">
      <ID>KPI</ID>
      <Name>Late Delivery Performance</Name>
      <AssociatedMeasureGroupID>Fact Sales</AssociatedMeasureGroupID>
      <Value>[Measures].[Late Delivery Rate]</Value>
      <Goal>0.10</Goal>
      <Status>CASE
    WHEN KpiValue("Late Delivery Performance") &lt;= KpiGoal("Late Delivery Performance")
        THEN 1
    WHEN KpiValue("Late Delivery Performance") &lt;= KpiGoal("Late Delivery Performance") * 1.2
        THEN 0
    ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="f0b6ebd2-6799-4ef7-b1aa-6f04658153a4">
      <ID>KPI 1</ID>
      <Name>Customer Satisfaction</Name>
      <AssociatedMeasureGroupID>Fact Sales</AssociatedMeasureGroupID>
      <Value>[Measures].[Avg Review Score]</Value>
      <Goal>4</Goal>
      <Status>CASE
    WHEN KpiValue("Customer Satisfaction") &gt;= KpiGoal("Customer Satisfaction")
        THEN 1
    WHEN KpiValue("Customer Satisfaction") &gt;= KpiGoal("Customer Satisfaction") * 0.9
        THEN 0
    ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>